<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Surface AOT-unfriendly code at build time. Classlibs don't
         get PublishAot (that's executable-only); IsAotCompatible
         flips on the trimmer + AOT analyzers so reflection/dynamic
         patterns warn here instead of breaking the host app's
         `dotnet publish`. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- JWT parsing for FirebaseIdentity. Microsoft.IdentityModel.JsonWebTokens
         is the modern AOT-friendly replacement for the older
         System.IdentityModel.Tokens.Jwt. We only construct JsonWebToken
         from a string and read claims — no signature validation (Firebase
         already signed it and we received it over TLS), no
         reflection-heavy paths. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.17.0" />
  </ItemGroup>

</Project>
