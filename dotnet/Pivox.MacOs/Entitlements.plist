<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug-only: allows Xcode / lldb to attach via task_for_pid.
	     Required for the view-hierarchy debugger. Strip for Release. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>

	<!-- Firebase Auth persists user sessions via macOS Data Protection
	     Keychain. Requires keychain-access-groups entitlement, AND a
	     provisioning profile that grants it. Team prefix below
	     (FAENDBN66M) matches the embedded.provisionprofile we copied
	     from the SwiftUI Pivox app. -->
	<key>keychain-access-groups</key>
	<array>
		<string>FAENDBN66M.app.pivox.native</string>
	</array>
</dict>
</plist>
