<Project>

  <!-- Repo-wide MSBuild defaults for every csproj/vbproj under
       dotnet/. Properties here merge with each project's
       PropertyGroup; per-project values override.

       Scope: ALL .NET projects in this directory tree pick this up
       automatically (MSBuild walks up from each project file
       looking for Directory.Build.props). Don't include
       framework-specific or platform-specific settings here —
       those belong in the individual csproj. This file is for
       cross-cutting policy ONLY.
  -->

  <PropertyGroup>
    <!-- Every warning is a build failure. We've kept the codebase
         warning-clean by hand so far; this locks the invariant in
         so a future regression fails CI / IDE instead of
         silently piling up. Aligns with the "Production-quality
         from the start" rule in CLAUDE.md.

         If a specific warning needs to be exempted for a real
         reason (e.g. an externally-generated source file we don't
         own), use <NoWarn> on the offending project OR add it to
         <WarningsNotAsErrors> below — never disable the global
         flag. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Nullable reference types: pin to enabled here so individual
         csprojs don't have to repeat the line. Existing projects
         all already set this; lifting it ensures any future
         project that forgets still gets the same behavior. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
