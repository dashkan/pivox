<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <!-- Project identifier is Pivox.macOS (matches csproj filename
         + slnx entry + filesystem dir), but the OUTPUT assembly and
         bundle drop the platform suffix so users see "Pivox.app",
         not "Pivox.macOS.app". The same pattern applies to the
         WinUI side: Pivox.WinUI.csproj produces Pivox.exe. -->
    <AssemblyName>Pivox</AssemblyName>

    <!-- Root namespace is Pivox (no platform suffix) so types live
         in `namespace Pivox` / `namespace Pivox.Auth` etc — matching
         what the SwiftUI side does and what Pivox.WinUI will mirror.
         Platform-specific class NAMES (MacOsAuthService,
         WindowsAuthService) carry the disambiguation; the namespace
         doesn't need to. -->
    <RootNamespace>Pivox</RootNamespace>

    <!-- NativeAOT — produces a static native binary, no Mono runtime.
         Only triggers on `dotnet publish` (not `dotnet build`), so
         Debug build-and-run stays fast. NativeAOT manages its own
         trimming; don't set TrimMode (the build warns when both
         are set). -->
    <PublishAot>true</PublishAot>

    <!-- Sign with the local Apple Development cert + reuse the same
         provisioning profile the SwiftUI Pivox app uses (copied to
         this dir as embedded.provisionprofile). The profile authorizes
         the cert to claim keychain-access-groups on bundle ID
         app.pivox.native for team FAENDBN66M.

         CodesignRequireProvisioningProfile=true is implicit when
         CodesignProvision is set, but declaring it explicitly silences
         Rider's design-time MT7139 warning (which doesn't fire on
         dotnet build CLI — Rider's analyzer evaluates entitlements
         slightly differently and benefits from the explicit hint). -->
    <EnableCodeSigning>true</EnableCodeSigning>
    <CodesignRequireProvisioningProfile>true</CodesignRequireProvisioningProfile>
    <CodesignKey>Apple Development: ashkan.daie@gmail.com (T55ZHGSMZJ)</CodesignKey>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <CodesignProvision>Mac Team Provisioning Profile: app.pivox.native</CodesignProvision>
  </PropertyGroup>

  <ItemGroup>
    <!-- Firebase Auth + Core bindings. Binding project embeds the
         11 transitive xcframeworks (FirebaseAuth, FirebaseCore,
         FirebaseInstallations, GoogleUtilities, GTMSessionFetcher,
         nanopb, FBLPromises, plus interop protocol declarations). -->
    <ProjectReference Include="..\Pivox.Firebase.Bindings\Pivox.Firebase.Bindings.csproj" />

    <!-- Cross-platform contracts (IAuthService, AuthSession, JWT
         claim helpers). Same library Windows will consume. -->
    <ProjectReference Include="..\Pivox.Shared\Pivox.Shared.csproj" />

    <!-- gRPC clients for pivox-cloud, generated from ../../api/proto/.
         Same library Windows will consume — only the AuthService
         implementation differs between platforms. -->
    <ProjectReference Include="..\Pivox.Client\Pivox.Client.csproj" />

    <!-- P/Invoke layer for the C++ markdown parser + Rust syntax
         highlighter (consumed by the AI chat feature). The dylibs
         themselves are carried as NativeReference items below so
         the .NET-for-macOS SDK places them in the .app bundle's
         Contents/MonoBundle/ alongside the managed assemblies —
         that's where the DllImport resolver looks first. -->
    <ProjectReference Include="..\Pivox.Native\Pivox.Native.csproj" />
  </ItemGroup>

  <!-- Native libs delivery into the .app bundle. .NET-for-macOS does
       NOT pick up cross-platform Pivox.Native's Content items into a
       location the runtime resolver searches (Content items land
       outside Contents/MonoBundle/). NativeReference Kind=Dynamic
       is the .NET-for-macOS-specific path that routes a .dylib into
       Contents/MonoBundle/ where DllImport finds it.

       The source paths point at Pivox.Native's staged runtimes/
       folder — `make ai-native` populates that. If the files are
       missing, the build fails clearly via Pivox.Native's
       EnsureAiNativeStaged target. -->
  <ItemGroup>
    <NativeReference Include="$(MSBuildThisFileDirectory)../Pivox.Native/runtimes/osx-arm64/native/libpivox_markdown.dylib">
      <Kind>Dynamic</Kind>
    </NativeReference>
    <NativeReference Include="$(MSBuildThisFileDirectory)../Pivox.Native/runtimes/osx-arm64/native/libpivox_highlight.dylib">
      <Kind>Dynamic</Kind>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Firebase config — FIRApp.Configure() reads this from
         the bundle's Resources/ at runtime. Same file the Swift app uses. -->
    <BundleResource Include="GoogleService-Info.plist" />
  </ItemGroup>
</Project>
