  <!-- Per-configuration Firebase lib paths.  The SDK ships separate
       Debug/Release libs under libs/windows/VS2019/MD/{platform}/{config}/.
       VS2019 libs work with v145 toolset (ABI-compatible). -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
