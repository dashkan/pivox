<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pivox.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PreviewKeyDown="Page_PreviewKeyDown">

    <!-- Centered floating card on the window's acrylic backdrop. -->
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <Border CornerRadius="20"
                Width="360"
                Padding="32"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

            <StackPanel Spacing="24">

                <!-- Header -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Pivox"
                               FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to your account"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Form -->
                <StackPanel Spacing="16">
                    <TextBox x:Name="EmailBox"
                             PlaceholderText="Email"
                             HorizontalAlignment="Stretch"
                             TextChanged="EmailBox_TextChanged" />

                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="Password"
                                 HorizontalAlignment="Stretch"
                                 Visibility="Collapsed"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <!-- Options row: remember-me + forgot password -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RememberMeCheckbox"
                                  Content="Remember me"
                                  Grid.Column="0"
                                  FontSize="14" />
                        <HyperlinkButton x:Name="ForgotPasswordButton"
                                         Content="Forgot password?"
                                         Grid.Column="1"
                                         FontSize="14"
                                         Visibility="Collapsed"
                                         Click="ForgotPasswordButton_Click" />
                    </Grid>

                    <!-- Primary button -->
                    <Button x:Name="PrimaryButton"
                            Content="Continue"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="PrimaryButton_Click" />

                    <!-- Error label — pre-allocated height -->
                    <TextBlock x:Name="ErrorLabel"
                               Text=" "
                               FontSize="14"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               MinHeight="20" />
                </StackPanel>

                <!-- Separator -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock Grid.Column="1" Text="or" Margin="8,0"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                </Grid>

                <!-- Social buttons -->
                <StackPanel Spacing="8">
                    <Button x:Name="GoogleButton"
                            HorizontalAlignment="Stretch"
                            Click="GoogleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="ms-appx:///Assets/GoogleLogo.svg"
                                   Width="16" Height="16" />
                            <TextBlock Text="Continue with Google" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="GitHubButton"
                            HorizontalAlignment="Stretch"
                            Click="GitHubButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="ms-appx:///Assets/GitHubLogo.svg"
                                   Width="16" Height="16" />
                            <TextBlock Text="Continue with GitHub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="Don't have an account?"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <HyperlinkButton Content="Create one"
                                     FontSize="14"
                                     Click="CreateOneButton_Click" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
