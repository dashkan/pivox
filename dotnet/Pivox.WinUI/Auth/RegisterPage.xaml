<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pivox.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PreviewKeyDown="Page_PreviewKeyDown">

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <Border CornerRadius="20"
                Width="360"
                Padding="32"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

            <StackPanel Spacing="24">

                <!-- Header -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Pivox"
                               FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Create your account"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Form -->
                <StackPanel Spacing="16">
                    <TextBox x:Name="EmailBox"
                             PlaceholderText="Email"
                             HorizontalAlignment="Stretch"
                             TextChanged="EmailBox_TextChanged" />

                    <TextBox x:Name="DisplayNameBox"
                             PlaceholderText="Display name"
                             HorizontalAlignment="Stretch"
                             TextChanged="DisplayNameBox_TextChanged" />

                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="Password"
                                 HorizontalAlignment="Stretch"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 PlaceholderText="Confirm password"
                                 HorizontalAlignment="Stretch"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                    <Button x:Name="CreateAccountButton"
                            Content="Create Account"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CreateAccountButton_Click" />

                    <TextBlock x:Name="ErrorLabel"
                               Text=" "
                               FontSize="14"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               MinHeight="20" />
                </StackPanel>

                <!-- Separator -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock Grid.Column="1" Text="or" Margin="8,0"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                </Grid>

                <!-- Social buttons -->
                <StackPanel Spacing="8">
                    <Button x:Name="GoogleButton"
                            HorizontalAlignment="Stretch"
                            Click="GoogleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="ms-appx:///Assets/GoogleLogo.svg"
                                   Width="16" Height="16" />
                            <TextBlock Text="Continue with Google" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="GitHubButton"
                            HorizontalAlignment="Stretch"
                            Click="GitHubButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="ms-appx:///Assets/GitHubLogo.svg"
                                   Width="16" Height="16" />
                            <TextBlock Text="Continue with GitHub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="Already have an account?"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <HyperlinkButton Content="Sign in"
                                     FontSize="14"
                                     Click="SignInButton_Click" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
