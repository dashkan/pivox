<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pivox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pivox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Mirrors DetailViewController's layout: email, password,
         sign-in buttons, gRPC test, status display. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="40">
        <StackPanel Spacing="12"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Pivox — .NET cross-platform spike"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Auth via IAuthService, gRPC via PivoxClient, both in Pivox.Shared/Pivox.Client."
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <TextBox x:Name="EmailBox"
                     PlaceholderText="Email"
                     HorizontalAlignment="Stretch" />

            <PasswordBox x:Name="PasswordBox"
                         PlaceholderText="Password"
                         HorizontalAlignment="Stretch" />

            <Button x:Name="SignInButton"
                    Content="Sign In"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SignInButton_Click" />

            <Button x:Name="GoogleSignInButton"
                    Content="Continue with Google"
                    HorizontalAlignment="Stretch"
                    Click="GoogleSignInButton_Click" />

            <Button x:Name="ListOrgsButton"
                    Content="Call pivox-cloud → ListOrganizations"
                    HorizontalAlignment="Stretch"
                    Click="ListOrgsButton_Click" />

            <Button x:Name="SignOutButton"
                    Content="Sign Out"
                    HorizontalAlignment="Stretch"
                    Click="SignOutButton_Click" />

            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="12"
                       IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Window>
