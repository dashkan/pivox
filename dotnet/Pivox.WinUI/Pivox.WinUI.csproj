<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Map solution platform → RID for publish/AOT. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Match Pivox.macOS: project name carries the platform suffix,
         but the output assembly drops it. Users see "Pivox.exe". -->
    <AssemblyName>Pivox</AssemblyName>

    <!-- Root namespace matches macOS side — platform-specific types
         are disambiguated by CLASS name (WindowsAuthService vs
         MacOsAuthService), not namespace. -->
    <RootNamespace>Pivox</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\GoogleLogo.svg" />
    <Content Include="Assets\GitHubLogo.svg" />
  </ItemGroup>

  <!-- Cross-platform contracts — same libraries the macOS app uses. -->
  <ItemGroup>
    <ProjectReference Include="..\Pivox.Shared\Pivox.Shared.csproj" />
    <ProjectReference Include="..\Pivox.Client\Pivox.Client.csproj" />
  </ItemGroup>

  <!-- C++/WinRT component wrapping Firebase C++ SDK.
       CsWinRT generates the C# projection from the .winmd at build. -->
  <ItemGroup>
    <ProjectReference Include="..\Pivox.Firebase.Native\Pivox.Firebase.Native.vcxproj" />
  </ItemGroup>

  <!-- Tell CsWinRT to project our component namespace. -->
  <PropertyGroup>
    <CsWinRTIncludes>Pivox.Firebase.Native</CsWinRTIncludes>
  </PropertyGroup>

  <!-- MSIX packaging -->
  <ItemGroup
    Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup
    Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish settings — only apply during `dotnet publish`, not build.
       NativeAOT: produces a static native binary like the macOS side.
       Only triggers at publish time, not build, so Debug F5 stays fast.
       NativeAOT manages its own trimming — don't set TrimMode separately. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxPackageDir>$(SolutionDir)AppPackages\</AppxPackageDir>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PackageCertificateThumbprint>5BF078D9D349759690E8002D0AADD284A8B0A675</PackageCertificateThumbprint>
  </PropertyGroup>
</Project>