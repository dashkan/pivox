{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    ".adal": true,
    ".aider-desk": true,
    ".augment": true,
    ".bob": true,
    ".codeartsdoer": true,
    ".codebuddy": true,
    ".codemaker": true,
    ".codestudio": true,
    ".commandcode": true,
    ".continue": true,
    ".cortex": true,
    ".crush": true,
    ".devin": true,
    ".factory": true,
    ".goose": true,
    ".forge": true,
    ".iflow": true,
    ".junia": true,
    ".junie": true,
    ".kilocode": true,
    ".kiro": true,
    ".kode": true,
    ".mcpjam": true,
    ".mux": true,
    ".neovate": true,
    ".openhands": true,
    ".pi": true,
    ".pochi": true,
    ".qoder": true,
    ".qwen": true,
    ".roo": true,
    ".rovodev": true,
    ".run": true,
    ".tabnine": true,
    ".trae": true,
    ".vibe": true,
    ".windsurf": true,
    ".zencoder": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.next": true,
    "**/storybook-static": true
  },
  "editor.formatOnSave": true,
  "emmet.includeLanguages": {
    "postcss": "css"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[proto]": {
    "editor.formatOnSave": false
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "makefile.configureOnOpen": false,

  // Don't block debug launches on pre-existing workspace error markers.
  // On macOS the C# Dev Kit can't restore the Windows-targeting .NET
  // projects (native/tests/windows-ui, dotnet/Pivox.WinUI) and parks
  // permanent NETSDK1100 errors in the Problems panel. With the default
  // "prompt", every launch (start, cloud, worker, envoy) hits
  // "Error exists after running preLaunchTask ...". Those errors are
  // cross-stack noise, never produced by our task problem matchers, so
  // launch anyway.
  "debug.onTaskErrors": "debugAnyway"
}
