{
  "name": "@pivox/observability",
  "version": "1.0.0",
  "description": "Error reporting + async-handler safety primitives",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./node": {
      "types": "./dist/esm/node-tracing.d.ts",
      "import": "./dist/esm/node-tracing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "test:build": "publint --strict",
    "test:lint": "oxlint --type-aware ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-web": "0.65.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/instrumentation": "0.220.0",
    "@opentelemetry/instrumentation-undici": "0.30.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-web": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  }
}
