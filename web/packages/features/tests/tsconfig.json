{
  // Lives in tests/ so tseslint's `projectService` picks it up by name
  // when walking up from any *.test.ts file. The parent
  // `../tsconfig.json` only includes `src/**/*` (drives the vite build);
  // this config widens the include to cover tests too, with rootDir
  // bumped to the package root so test files can resolve `@/foo`
  // back to ../src/foo.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "..",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["./**/*", "../src/**/*"]
}
