{
  "name": "@pivox/storage",
  "version": "1.0.0",
  "description": "Browser storage layer — cookie + localStorage dual-store with SSR-readable item descriptors",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "sideEffects": [
    "./src/items.ts",
    "./dist/esm/items.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react.d.ts",
      "import": "./dist/esm/react.js"
    },
    "./test-utils": {
      "types": "./dist/esm/test-utils.d.ts",
      "import": "./dist/esm/test-utils.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "test:build": "publint --strict",
    "test:lint": "oxlint --type-aware ./src ./tests",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "peerDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "vite": "catalog:"
  }
}
