{
  "name": "pivox",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820",
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" run clean",
    "build": "pnpm --filter \"./packages/**\" run build",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test:eslint": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run test:eslint",
    "test:types": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run test:types",
    "web:build": "pnpm run build",
    "web:build:primitives": "pnpm --filter @pivox/primitives run build",
    "web:build:image-editor": "pnpm --filter @pivox/image-editor run build",
    "web:build:features": "pnpm --filter @pivox/features build",
    "web:build:ui": "pnpm --filter @pivox/ui build",
    "web:clean": "pnpm clean",
    "web:start": "pnpm --filter @pivox/start dev",
    "electron:start": "pnpm --filter @pivox/electron dev"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "premove": "^4.0.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
