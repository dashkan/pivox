    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.6.0",
    "premove": "4.0.0",
    "prettier": "3.8.3",
    "publint": "0.3.21",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vite-plugin-dts": "5.0.1",
    "vite-plugin-externalize-deps": "0.10.0",
    "vitest": "4.1.7"
  }
