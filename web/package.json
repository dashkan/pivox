  "type": "module",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" run clean",
    "build": "pnpm --filter \"./packages/**\" run build",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test:eslint": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run test:eslint",
    "test:types": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run test:types",
    "web:build": "pnpm run build",
    "web:build:primitives": "pnpm --filter @pivox/primitives run build",
    "web:build:image-editor": "pnpm --filter @pivox/image-editor run build",
    "web:build:features": "pnpm --filter @pivox/features build",
    "web:build:ui": "pnpm --filter @pivox/ui build",
    "web:build:client": "pnpm --filter @pivox/client build",
    "web:build:storage": "pnpm --filter @pivox/storage build",
    "web:build:start": "pnpm --filter @pivox/start build",
    "web:clean": "pnpm clean",
    "web:start": "pnpm --filter @pivox/start dev",
    "web:start:preview": "pnpm --filter @pivox/start preview",
    "electron:start": "pnpm --filter @pivox/electron dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.6.0",
    "premove": "4.0.0",
    "prettier": "3.8.3",
    "publint": "0.3.21",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vite-plugin-dts": "5.0.1",
    "vite-plugin-externalize-deps": "0.10.0",
    "vitest": "4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
