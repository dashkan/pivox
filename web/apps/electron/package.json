{
  "name": "@pivox/electron",
  "version": "1.0.0",
  "description": "Pivox desktop application",
  "main": "./out/main/index.js",
  "author": "Pivox",
  "homepage": "https://pivox.app",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test:eslint": "pnpm lint",
    "test:types": "pnpm typecheck",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "install:electron": "install-electron",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@pivox/client": "workspace:*",
    "@pivox/features": "workspace:*",
    "@pivox/observability": "workspace:*",
    "@pivox/primitives": "workspace:*",
    "@pivox/storage": "workspace:*",
    "@pivox/ui": "workspace:*",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.15",
    "electron-updater": "6.8.9",
    "firebase": "12.14.0",
    "lucide-react": "1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-plugin": "1.168.18",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "5.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
