{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.mts",
    "vitest.config.ts",
    "vitest.renderer.config.mts",
    "src/main.ts",
    "src/main/**/*",
    "src/preload.ts",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["vite/client", "node"]
  }
}
