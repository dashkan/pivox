<Project>
  <!-- Override CMake's per-config CharacterSet=MultiByte. WinUI/WinRT requires Unicode. -->
  <PropertyGroup Condition="'$(ProjectName)' == 'Pivox' OR '$(ProjectName)' == 'PivoxActiveX'">
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <!-- module.g.cpp provides WinRT activation factories for XAML types. -->
  <ItemGroup Condition="'$(ProjectName)' == 'Pivox' OR '$(ProjectName)' == 'PivoxActiveX'">
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(ProjectName)' == 'Pivox' OR '$(ProjectName)' == 'PivoxActiveX'">
    <Midl><OutputDirectory /></Midl>
  </ItemDefinitionGroup>
</Project>
