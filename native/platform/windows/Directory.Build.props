<Project>
  <PropertyGroup Condition="'$(ProjectName)' == 'Pivox' OR '$(ProjectName)' == 'PivoxActiveX'">
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProjectName)' == 'Pivox'">
    <RuntimeIdentifiers>win10-x64;win10-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProjectName)' == 'PivoxActiveX'">
    <RuntimeIdentifiers>win10-x86</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
