<Window
    x:Class="PivoxApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PivoxApp"
    Title="Pivox">

    <Grid>
        <!-- Auth screens shown when logged out -->
        <Grid x:Name="AuthContainer" Visibility="Visible">
            <Frame x:Name="AuthFrame" />
        </Grid>

        <!-- Main app shown when logged in -->
        <Grid x:Name="MainContainer" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Menu bar (window-level, not shared) -->
            <MenuBar Grid.Row="0">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New Show" />
                    <MenuFlyoutItem Text="Open Show..." />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnMenuExit" />
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Text="Undo" />
                    <MenuFlyoutItem Text="Redo" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Cut" />
                    <MenuFlyoutItem Text="Copy" />
                    <MenuFlyoutItem Text="Paste" />
                    <MenuFlyoutItem Text="Select All" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Toggle Sidebar" Click="OnMenuToggleSidebar" />
                </MenuBarItem>
                <MenuBarItem Title="Window">
                    <MenuFlyoutItem Text="Minimize" Click="OnMenuMinimize" />
                    <MenuFlyoutItem Text="Maximize" Click="OnMenuMaximize" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="Pivox Help" />
                    <MenuFlyoutItem Text="About Pivox" />
                </MenuBarItem>
            </MenuBar>

            <!-- Shared MainPage (NavigationView + sidebar) -->
            <Frame x:Name="MainFrame" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
