<Page
    x:Class="Pivox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivox"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        IsPaneOpen="True"
        SelectionChanged="OnNavSelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Operator" Tag="Operator"
                AutomationProperties.AutomationId="nav-operator">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Library" Tag="Library"
                AutomationProperties.AutomationId="nav-library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Designer" Tag="Designer"
                AutomationProperties.AutomationId="nav-designer">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Engineering" Tag="Engineering"
                AutomationProperties.AutomationId="nav-engineering">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE90F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Admin" Tag="Admin"
                AutomationProperties.AutomationId="nav-admin">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Profile" Tag="Profile"
                AutomationProperties.AutomationId="nav-profile">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="40">
            <StackPanel
                x:Name="ContentPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    x:Name="SectionTitle"
                    Text="Operator"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Coming soon"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel
                x:Name="ProfilePanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20"
                Width="300">
                <PersonPicture
                    x:Name="ProfileAvatar"
                    Width="64" Height="64"
                    DisplayName="User" />
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="ProfileName"
                        Text="User"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="profile-display-name" />
                    <TextBlock
                        x:Name="ProfileEmail"
                        Text=""
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="profile-email" />
                </StackPanel>
                <MenuFlyoutSeparator />
                <Button Content="Account Settings" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="profile-account-settings" />
                <Button
                    Content="Sign Out"
                    HorizontalAlignment="Stretch"
                    Click="OnSignOut"
                    Foreground="Red"
                    AutomationProperties.AutomationId="profile-sign-out" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Page>
