<Page
    x:Class="Pivox.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivox"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnPageLoaded">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel
            Width="380"
            Padding="32"
            Spacing="24"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <!-- Header -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock
                    Text="Pivox"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Sign in to your account"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Spacing="16">
                <TextBox
                    x:Name="EmailBox"
                    Header="Email"
                    PlaceholderText="you@example.com"
                    KeyDown="OnEmailKeyDown"
                    TextChanged="OnFormChanged"
                    AutomationProperties.AutomationId="login-email"
                    AutomationProperties.Name="Email address" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Header="Password"
                    PlaceholderText="Password"
                    KeyDown="OnPasswordKeyDown"
                    PasswordChanged="OnFormChanged"
                    AutomationProperties.AutomationId="login-password"
                    AutomationProperties.Name="Password" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="RememberMeCheck" Content="Remember me" Grid.Column="0"
                        AutomationProperties.AutomationId="login-remember-me" />
                    <HyperlinkButton
                        x:Name="ForgotPasswordLink"
                        Content="Forgot password?"
                        Grid.Column="1"
                        Padding="0"
                        AutomationProperties.AutomationId="login-forgot-password" />
                </Grid>

                <Button
                    x:Name="SignInButton"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnSignIn"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="login-sign-in">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <ProgressRing
                            x:Name="SignInSpinner"
                            IsActive="False"
                            Visibility="Collapsed"
                            Width="16" Height="16" />
                        <TextBlock x:Name="SignInText" Text="Sign In" />
                    </StackPanel>
                </Button>

                <!-- Error message below button -->
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="Red"
                    FontSize="12"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Opacity="0"
                    Text=" "
                    AutomationProperties.AutomationId="login-error" />
            </StackPanel>

            <!-- Separator -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <MenuFlyoutSeparator Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="or"
                    Margin="12,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <MenuFlyoutSeparator Grid.Column="2" VerticalAlignment="Center" />
            </Grid>

            <!-- Social login -->
            <StackPanel Spacing="8">
                <Button x:Name="GoogleSignInButton" HorizontalAlignment="Stretch" Click="OnGoogleSignIn" AutomationProperties.AutomationId="login-google">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4285F4" Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                                <Path Fill="#34A853" Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                                <Path Fill="#FBBC05" Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                                <Path Fill="#EA4335" Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Continue with Google" />
                    </StackPanel>
                </Button>
                <Button x:Name="GitHubSignInButton" HorizontalAlignment="Stretch" Click="OnGitHubSignIn" AutomationProperties.AutomationId="login-github">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16" Data="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" />
                        <TextBlock Text="Continue with GitHub" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    Text="Don't have an account?"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton
                    x:Name="SwitchToRegisterLink"
                    Content="Create one"
                    Padding="0"
                    Click="OnSwitchToRegister"
                    AutomationProperties.AutomationId="login-switch-register" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
