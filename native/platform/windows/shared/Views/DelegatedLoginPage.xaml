<Page
    x:Class="Pivox.DelegatedLoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel
            Width="380"
            Padding="32"
            Spacing="24"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <!-- Header -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock
                    Text="Pivox"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Sign in to continue"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Sign In Button -->
            <Button
                x:Name="SignInButton"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Click="OnSignIn"
                AutomationProperties.AutomationId="delegated-sign-in">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <ProgressRing
                        x:Name="SignInSpinner"
                        IsActive="False"
                        Visibility="Collapsed"
                        Width="16" Height="16" />
                    <TextBlock x:Name="SignInText" Text="Sign In with Pivox" />
                </StackPanel>
            </Button>

            <!-- Error / status -->
            <TextBlock
                x:Name="ErrorText"
                Foreground="Red"
                FontSize="12"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Opacity="0"
                Text=" "
                AutomationProperties.AutomationId="delegated-error" />
        </StackPanel>
    </Grid>
</Page>
